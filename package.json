{
  "name": "grapdf",
  "version": "1.1.1",
  "description": "Scrape all PDFs from a webpage and merge them into one downloadable booklet",
  "keywords": [
    "cli",
    "pdf",
    "merge",
    "booklet",
    "scraper"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jayrdeaton/grapdf.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "grapdf": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "ci": "npm run lint && npm test && npm run typecheck && npm run build",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run ci",
    "watch": "tsup --watch"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "cheerio": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "termkit": "^2.4.8"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.1",
    "@infinitetoken/tsconfig": "^0.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0"
  }
}
